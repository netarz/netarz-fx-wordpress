#. Plugin Name of the plugin
#: netarz-fx.php includes/class-netarz-fx-settings.php:85
#: includes/class-netarz-fx-settings.php:135
msgid "NetArz Currency & Gold Rates"
msgstr "نرخ ارز و طلای نِت اَرز"

#. Plugin URI of the plugin
#: netarz-fx.php
msgid "https://github.com/netarz/netarz-fx-wordpress"
msgstr "https://github.com/netarz/netarz-fx-wordpress"

#. Description of the plugin
#: netarz-fx.php
msgid "Exchange rates in Iranian Toman, the global gold and silver price and a clearly labelled computed value of 18k gold and Iranian gold coins, from NetArz. Shortcodes, blocks, charts and widgets. Nothing is fetched until you turn the connection on."
msgstr "نرخ ارز به تومان، قیمت جهانی طلا و نقره و ارزش محاسبه‌ای طلای ۱۸ عیار و سکه با برچسب روشن، از نِت اَرز. با کد کوتاه، بلوک، نمودار و ابزارک. تا اتصال را روشن نکنید، هیچ داده‌ای دریافت نمی‌شود."

