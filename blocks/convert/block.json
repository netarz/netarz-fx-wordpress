{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "netarz-fx/convert",
	"version": "1.1.0",
	"title": "NetArz currency converter",
	"category": "widgets",
	"icon": "update",
	"description": "Converts between Toman and a currency as the visitor types, with rates from the NetArz FX API.",
	"keywords": [ "currency", "converter", "dollar", "toman", "calculator" ],
	"textdomain": "netarz-fx",
	"attributes": {
		"currencies": { "type": "string", "default": "USD,EUR,AED,TRY" },
		"field": { "type": "string", "enum": [ "buy", "sell", "mid" ], "default": "sell" },
		"amount": { "type": "number", "default": 1 },
		"showUpdated": { "type": "boolean", "default": false },
		"digits": { "type": "string", "enum": [ "", "persian", "latin" ], "default": "" }
	},
	"supports": {
		"html": false,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true },
		"color": { "text": true, "background": true }
	},
	"editorScript": "netarz-fx-blocks",
	"style": "netarz-fx"
}
