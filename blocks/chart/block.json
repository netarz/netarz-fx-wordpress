{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "netarz-fx/chart",
	"version": "2.0.1",
	"title": "NetArz price chart",
	"category": "widgets",
	"icon": "chart-line",
	"description": "A line chart of the gold ounce, the silver ounce or 18k gold over a period, drawn on your server as SVG. Needs a free NetArz FX API key.",
	"keywords": [ "chart", "gold", "history", "price", "graph" ],
	"textdomain": "netarz-fx",
	"attributes": {
		"symbol": { "type": "string", "default": "XAU" },
		"range": { "type": "string", "enum": [ "7d", "30d", "90d", "6m", "1y", "5y" ], "default": "30d" },
		"height": { "type": "number", "default": 220 },
		"digits": { "type": "string", "enum": [ "", "persian", "latin" ], "default": "" }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true },
		"color": { "text": true, "background": true }
	},
	"editorScript": "netarz-fx-blocks",
	"style": "netarz-fx"
}
